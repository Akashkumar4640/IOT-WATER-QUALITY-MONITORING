{
  "name": "iot-water-quality-system-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Root workspace proxy for IoT Water Quality Analyzer",
  "scripts": {
    "dev": "npm --prefix \"IOT PROJECT\" run dev",
